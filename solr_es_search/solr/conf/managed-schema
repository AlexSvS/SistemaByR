<?xml version="1.0" encoding="UTF-8"?>
<schema name="es_search" version="1.6">
  <field name="_version_" type="long" indexed="true" stored="true"/>
  <field name="id" type="string" indexed="true" stored="true" required="true"/>
  <field name="url" type="string" indexed="true" stored="true"/>
  <field name="title" type="text_es" indexed="true" stored="true"/>
  <field name="content" type="text_es" indexed="true" stored="true"/>
  <field name="category" type="string" indexed="true" stored="true"/>
  <field name="timestamp" type="date" indexed="true" stored="true"/>
  <field name="suggest" type="text_suggest" indexed="true" stored="true"/>
  <field name="all_text" type="text_es" indexed="true" stored="false"/>
  <field name="title_sort" type="string" indexed="true" stored="false"/>
  <field name="*_str" type="string" indexed="true" stored="true" docValues="true"/>
  <field name="*_txt" type="text_es" indexed="true" stored="true"/>
  <field name="*_i" type="int" indexed="true" stored="true" docValues="true"/>
  <field name="*_l" type="long" indexed="true" stored="true" docValues="true"/>
  <field name="*_dt" type="date" indexed="true" stored="true" docValues="true"/>
  <field name="*_s" type="string" indexed="true" stored="true" docValues="true"/>
  <field name="*_ss" type="string" indexed="true" stored="true" docValues="true"/>
  <field name="*_t" type="text_es" indexed="true" stored="true"/>
  <field name="*_b" type="boolean" indexed="true" stored="true" docValues="true"/>
  <field name="*_f" type="float" indexed="true" stored="true" docValues="true"/>
  <field name="*_d" type="double" indexed="true" stored="true" docValues="true"/>
  <field name="*_p" type="double" indexed="true" stored="true" docValues="true"/>
  <field name="*_m" type="text_general" indexed="true" stored="true"/>
  <fieldType name="string" class="solr.StrField" sortMissingLast="true"/>
  <fieldType name="long" class="solr.LongPointField"/>
  <fieldType name="date" class="solr.DatePointField"/>
  <fieldType name="boolean" class="solr.BoolField"/>
  <fieldType name="int" class="solr.IntPointField"/>
  <fieldType name="float" class="solr.FloatPointField"/>
  <fieldType name="double" class="solr.DoublePointField"/>
  <fieldType name="text_general" class="solr.TextField">
    <analyzer>
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
  </fieldType>
  <fieldType name="text_es" class="solr.TextField" positionIncrementGap="100">
    <analyzer type="index">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.StopFilterFactory" ignoreCase="true" words="stopwords_es.txt"/>
      <filter class="solr.SynonymGraphFilterFactory" synonyms="synonyms.txt" ignoreCase="true" expand="true"/>
      <filter class="solr.SnowballPorterFilterFactory" language="Spanish"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.StopFilterFactory" ignoreCase="true" words="stopwords_es.txt"/>
      <filter class="solr.SynonymGraphFilterFactory" synonyms="synonyms.txt" ignoreCase="true" expand="true"/>
      <filter class="solr.SnowballPorterFilterFactory" language="Spanish"/>
    </analyzer>
  </fieldType>
  <fieldType name="text_suggest" class="solr.TextField">
    <analyzer>
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
  </fieldType>
  <similarity class="solr.ClassicSimilarityFactory"/>
</schema>
